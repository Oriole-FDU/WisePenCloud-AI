      "metadata": {
        "s2": {
          "corpus_id": "13756489",
          "paper_id": "204e3073870fae3d05bcbc2f6a8e263d9b72e776",
          "citation_count": 199000,
          "influential_citation_count": 21110,
          "is_open_access": false,
          "tldr": {
            "text": "A new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely is proposed, which generalizes well to other tasks by applying it successfully to English constituency parsing both with large and limited training data."
          },
          "open_access_pdf": null,
          "bibtex": "@Article{Vaswani2017AttentionIA,\n author = {Ashish Vaswani and Noam Shazeer and N. Parmar and J. Uszkoreit and Llion Jones and Aidan N. Gomez and Lukasz Kaiser and I. Polosukhin},\n booktitle = {Neural Information Processing Systems},\n pages = {5998-6008},\n title = {Attention is All you Need},\n year = {2017}\n}\n",
          "venue": "Neural Information Processing Systems"
        }
      },
      "metadata_bytes": 883
    },
    {
      "title": "DeepSeek-R1 incentivizes reasoning in LLMs through reinforcement learning",
