{
  "$defs": {
    "ChunkHit": {
      "description": "应用可见的正文命中；score 表示最终排序阶段，不限定为重排分数。",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "content_revision": {
          "title": "Content Revision",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section Id"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "seed_entities": {
          "items": {
            "$ref": "#/$defs/GraphNodeReference"
          },
          "title": "Seed Entities",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "resource_id",
        "content_revision",
        "section_id",
        "section_path",
        "text",
        "rank",
        "score"
      ],
      "title": "ChunkHit",
      "type": "object"
    },
    "GraphDirection": {
      "enum": [
        "outgoing",
        "incoming",
        "both"
      ],
      "title": "GraphDirection",
      "type": "string"
    },
    "GraphNodeReference": {
      "description": "命中 Chunk 中可供调用方选择的实体；来源身份沿用外层 ChunkHit。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "relations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GraphRelationOption"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relations"
        }
      },
      "required": [
        "id"
      ],
      "title": "GraphNodeReference",
      "type": "object"
    },
    "GraphRelationOption": {
      "description": "类别允许的谓词与方向提示，不表示当前可见事实存在该关系。",
      "properties": {
        "relation_type": {
          "title": "Relation Type",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/GraphDirection"
        }
      },
      "required": [
        "relation_type",
        "direction"
      ],
      "title": "GraphRelationOption",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/ChunkHit"
  },
  "type": "array"
}
