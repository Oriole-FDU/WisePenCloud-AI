{
  "$defs": {
    "ChunkHit": {
      "description": "应用可见的正文命中；score 表示最终排序阶段，不限定为重排分数。",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "content_revision": {
          "title": "Content Revision",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section Id"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "seed_entities": {
          "items": {
            "$ref": "#/$defs/GraphNodeReference"
          },
          "title": "Seed Entities",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "resource_id",
        "content_revision",
        "section_id",
        "section_path",
        "text",
        "rank",
        "score"
      ],
      "title": "ChunkHit",
      "type": "object"
    },
    "GraphDirection": {
      "enum": [
        "outgoing",
        "incoming",
        "both"
      ],
      "title": "GraphDirection",
      "type": "string"
    },
    "GraphEntity": {
      "description": "一个逻辑实体只返回一次；不重复名称、本体、类别和本体允许提示。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/GraphEntitySource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "GraphEntity",
      "type": "object"
    },
    "GraphEntitySource": {
      "description": "一个已授权 Chunk 对实体的描述，不拼接或摘要其他来源。",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "chunk_id"
      ],
      "title": "GraphEntitySource",
      "type": "object"
    },
    "GraphNodeReference": {
      "description": "命中 Chunk 中可供调用方选择的实体；来源身份沿用外层 ChunkHit。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "relations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GraphRelationOption"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relations"
        }
      },
      "required": [
        "id"
      ],
      "title": "GraphNodeReference",
      "type": "object"
    },
    "GraphRelationOption": {
      "description": "类别允许的谓词与方向提示，不表示当前可见事实存在该关系。",
      "properties": {
        "relation_type": {
          "title": "Relation Type",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/GraphDirection"
        }
      },
      "required": [
        "relation_type",
        "direction"
      ],
      "title": "GraphRelationOption",
      "type": "object"
    },
    "GraphRelationship": {
      "description": "以完整关系 ID 标识有向谓词事实，来源字段独立保留。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/GraphRelationshipSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "GraphRelationship",
      "type": "object"
    },
    "GraphRelationshipSource": {
      "description": "关系的来源相关字段，关键词和 metadata 不跨来源合并。",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "keywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keywords"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id"
      ],
      "title": "GraphRelationshipSource",
      "type": "object"
    }
  },
  "description": "共享图事实与精排原文并列；top_k 和 rank/score 仅作用于 chunks。",
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/$defs/GraphEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/GraphRelationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/ChunkHit"
      },
      "title": "Chunks",
      "type": "array"
    }
  },
  "title": "GraphRetrievalResult",
  "type": "object"
}
