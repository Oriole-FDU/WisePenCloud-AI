# Bootstrap only; business settings come from wisepen-scholar-service-dev.yaml in Nacos.
NACOS_ENABLED=true
PROFILE=dev
SERVICE_HOST=127.0.0.1
NACOS_SERVER_ADDR=wisepen-dev-server:8848
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE_ID=
NACOS_USERNAME=
NACOS_PASSWORD=
# NACOS_ENABLED=false 时，在本文件提供 AppSettings 所需业务配置。
# 默认从 Nacos 获取 S2_API_KEY、OPENALEX_API_KEY、HF_TOKEN。
S2_API_KEY=
