[Unit]
Description=WisePen Scholar daily arXiv OAI and S2 API synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wisepen-cloud-ai
EnvironmentFile=/etc/wisepen/scholar-sync.env
ExecStart=/usr/local/bin/uv run --no-sync python services/wisepen-scholar-service/deploy/run.py sync-arxiv
TimeoutStartSec=infinity
